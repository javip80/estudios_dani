{ q: "TEORÍA: Si te ofrecen bebida en un restaurante y decides en ese segundo, dices:", options: ["I will have water, please.", "I am going to have water.", "I am having water.", "I have water."], correct: "I will have water, please.", hint: "Es una decisión espontánea." },
{ q: "TEORÍA: Las palabras 'Next weekend', 'Tomorrow' o 'In 2050' indican...", options: ["Futuro", "Pasado", "Presente", "Rutina"], correct: "Futuro", hint: "Expresan tiempo que aún no ha ocurrido." },
{ q: "TEORÍA: Si tu madre te riñe por tu habitación desordenada y quieres prometerle que la limpiarás, dices:", options: ["I will clean it, I promise.", "I am going to clean it.", "I am cleaning it.", "I clean it."], correct: "I will clean it, I promise.", hint: "Promesa = Will." },
{ q: "TEORÍA: ¿Qué palabra interrogativa usamos para preguntar 'Dónde' irá alguien?", options: ["Where", "What", "When", "Who"], correct: "Where", hint: "Where = Dónde." },

--- HARÁ / NO VA A SER (15 preguntas) ---
{ q: "¡El teléfono está sonando! - No te preocupes, yo ___ contesto.", opciones: ["will", "voy a", "estoy respondiendo", "answer"], correcto: "will", pista: "Decisión rápida." },
{ q: "Prometo que ___ cuento tu secreto a cualquiera.", opciones: ["no't", "no lo haré", "no", "no lo diré"], correcto: "no't", pista: "Promesa en negativo = won't." },
{ q: "Creo que en 2080, los humanos ___ viven en Marte.", opciones: ["harán", "van a", "están viviendo", "vivirán"], correcto: "harán", pista: "Predicción basada en opinión (creo)." },
{ q: "¿Tienes hambre? Te hago un sándwich.", opciones: ["hará", "voy a", "voy a preparar", "hago"], correcto: "will", pista: "Decisión espontánea para ayudar." },
{ q: "Quizá ___ llueva mañana, pero no estoy seguro.", opciones: ["hará", "va a", "está lloviendo", "llueve", correcto: "will", pista: "Predicción con 'maybe' (quizás), no hay seguridad." },
