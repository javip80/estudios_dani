{ q: "¡Tengo sed! - Yo ___ te traigo un vaso de agua.", opciones: ["hará", "voy a", "voy a traer", "traer"], correcto: "will", pista: "Decisión rápida para ser amable." },
{ q: "No creo que ___ haya aprobado el examen. No estudió.", opciones: ["va", "va a", "está aprobando", "aproba"], correcto: "va", pista: "opinión personal (no creo)." },
{ q: "Hace demasiado calor aquí dentro. Yo ___ abro la ventana.", opciones: ["hará", "voy a", "estoy abriendo", "abrir"], correcto: "will", pista: "Decisión en el momento." },
{ q: "Prometo que ___ te ayudo con los deberes.", opciones: ["hará", "voy a", "estoy ayudando", "ayudar"], correcto: "will", pista: "Promesa." },
{ q: "What ___ you do when you are 30 years old?", options: ["will", "are going to", "are doing", "do"], correct: "will", hint: "Pregunta sobre predicciones de futuro." },
{ q: "People ___ eat normal food in 2090. They will eat pills.", options: ["won't", "aren't going to", "aren't eating", "don't"], correct: "won't", hint: "Predicción de futuro en negativo." },
{ q: "___ astronauts travel to Jupiter in the future?", options: ["Will", "Are going to", "Are", "Do"], correct: "Will", hint: "Pregunta de predicción." },
{ q: "Someone is knocking at the door! - I ___ go.", options: ["will", "am going to", "am going", "go"], correct: "will", hint: "Decisión rápida." },

// --- BE GOING TO (15 preguntas) ---
{ q: "Why are you wearing old clothes? - Because I ___ paint my room.", options: ["am going to", "will", "am painting", "paint"], correct: "am going to", hint: "Ya tenías la intención, por eso te pusiste la ropa." },
{ q: "Look at those black clouds! It ___ rain.", options: ["is going to", "will", "is raining", "rains"], correct: "is going to", hint: "Evidencia visual." },
{ q: "Watch out! You ___ drop those plates!", options: ["are going to", "will", "are dropping", "drop"], correct: "are going to", hint: "Lo ves venir, es inminente." },
{ q: "Next year, I ___ study harder. (Intention)", options: ["am going to", "will", "am studying", "study"], correct: "am going to", hint: "Es tu intención o propósito." },
{ q: "He ___ buy a new car. He has saved a lot of money.", options: ["is going to", "will", "is buying", "buys"], correct: "is going to", hint: "Intención respaldada (ha ahorrado dinero)." },
{ q: "Oh no! The boat has a hole! It ___ sink!", options: ["is going to", "will", "is sinking", "sinks"], correct: "is going to", hint: "Evidencia inminente (el agujero en el barco)." },
{ q: "What ___ you ___ do this weekend?", options: ["are / going to", "will / do", "are / doing", "do / do"], correct: "are / going to", hint: "Preguntando por intenciones." },
{ q: "We ___ travel to Japan next summer. We are planning it.", options: ["are going to", "will", "are traveling", "travel"], correct: "are going to", hint: "Es un plan/intención que están preparando." },
{ q: "Look at that boy on the bike! He ___ crash!", options: ["is going to", "will", "is crashing", "crashes"], correct: "is going to", hint: "Evidencia visual." },
{ q: "I ___ eat junk food anymore. I want to be healthy.", options: ["am not going to", "won't", "am not eating", "don't eat"], correct: "am not going to", hint: "Una fuerte intención personal." },
{ q: "My sister ___ have a baby! Look at her belly!", options: ["is going to", "will", "is having", "has"], correct: "is going to", hint: "Evidencia biológica visible." },
{ q: "They ___ visit their grandparents this afternoon.", options: ["are going to", "will", "visit", "visits"], correct: "are going to", hint: "Intención para esta tarde." },
{ q: "___ she ___ participate in the contest?", options: ["Is / going to", "Will / participate", "Is / participating", "Does / participate"], correct: "Is / going to", hint: "Pregunta sobre la intención de ella." },
{ q: "He is running very fast! He ___ win the race!", options: ["is going to", "will", "is winning", "wins"], correct: "is going to", hint: "Evidencia en medio de la carrera." },
{ q: "I ___ save money to buy a computer.", options: ["am going to", "will", "am saving", "save"], correct: "am going to", hint: "Propósito o intención." },

// --- PRESENT CONTINUOUS FOR FUTURE (15 preguntas) ---
{ q: "Tomorrow at 5 PM, I ___ the dentist. (Cita en la agenda)", options: ["am visiting", "will visit", "am going to visit", "visit"], correct: "am visiting", hint: "Cita médica fija = Present Continuous." },
{ q: "Next Saturday at 10:00, Tom ___ in the football final.", options: ["is playing", "will play", "plays", "is going to play"], correct: "is playing", hint: "Evento oficial cerrado con hora y fecha." },
