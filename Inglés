{ q: "TEORÍA: ¿Cuál es la estructura correcta del 'Present Continuous' para futuro?", options: ["am/is/are + verbo en -ing", "will + verbo en -ing", "am/is/are + verbo normal", "going to + verbo en -ing"], correct: "am/is/are + verbo en -ing", hint: "Ejemplo: I AM PLAYING tennis tomorrow." },
