{ q: "On Sunday at 14:00, Sarah ___ lunch with her grandma.", options: ["is having", "will have", "has", "is going to have"], correct: "is having", hint: "Cita programada con hora." },
{ q: "I can't go to the cinema tonight because I ___ for the exam.", options: ["am studying", "will study", "study", "am going to study"], correct: "am studying", hint: "Plan fijo inamovible para esta noche." },
{ q: "___ you ___ anything tomorrow evening?", options: ["Are / doing", "Will / do", "Are / going to do", "Do / do"], correct: "Are / doing", hint: "Preguntando por planes fijos (agenda)." },
{ q: "They ___ a marathon on Sunday at 9 AM.", options: ["are running", "will run", "run", "are going to run"], correct: "are running", hint: "Evento oficial con horario." },
{ q: "My parents ___ dinner with their friends tonight.", options: ["are having", "will have", "have", "are going to have"], correct: "are having", hint: "Cena organizada = plan fijo." },
{ q: "He ___ his teacher tomorrow morning at school.", options: ["is meeting", "will meet", "meets", "is going to meet"], correct: "is meeting", hint: "Reunión concertada en la agenda." },
{ q: "Sorry, I can't. I ___ my bedroom this afternoon.", options: ["am painting", "will paint", "paint", "am going to paint"], correct: "am painting", hint: "Lo tienes en tu agenda personal como plan inamovible." },
{ q: "We ___ a rock concert on Saturday night. Here are the tickets!", options: ["are watching", "will watch", "watch", "are going to watch"], correct: "are watching", hint: "Entradas en la mano = Present Continuous." },
{ q: "She ___ an English exam on Friday at 11:00.", options: ["is taking", "will take", "takes", "is going to take"], correct: "is taking", hint: "Fecha y hora del instituto." },
{ q: "I ___ my suitcase tonight because my flight is tomorrow.", options: ["am packing", "will pack", "pack", "am going to pack"], correct: "am packing", hint: "Acción programada obligatoria." },
