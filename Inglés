// =====================================
// ESTADOS Y VARIABLES
// =====================================
let currentQuestions = [];
let currentIndex = 0;
let correctAnswers = 0;
let wrongAnswers = 0;
let mistakes = [];
let reviewMode = false;
const QUESTIONS_PER_TEST = 30;

// Elementos DOM
const questionText = document.getElementById("question-text");
const optionsContainer = document.getElementById("options-container");
const nextBtn = document.getElementById("next-btn");
const correctCount = document.getElementById("correct-count");
const wrongCount = document.getElementById("wrong-count");
const questionNumber = document.getElementById("question-number");
const questionTotal = document.getElementById("question-total");
const progressBar = document.getElementById("progress-bar");
const quizScreen = document.getElementById("quiz-screen");
const resultScreen = document.getElementById("result-screen");
const resultTitle = document.getElementById("result-title");
const finalScore = document.getElementById("final-score");
const finalPercentage = document.getElementById("final-percentage");
const mistakesSection = document.getElementById("mistakes-section");
const mistakesList = document.getElementById("mistakes-list");
const reviewBtn = document.getElementById("review-btn");
const restartBtn = document.getElementById("restart-btn");
const modeBadge = document.getElementById("mode-badge");

// =====================================
// UTILIDADES
// =====================================
function shuffle(array){
const arr = [...array];
for(let i = arr.length - 1; i > 0; i--){
const j = Math.floor(Math.random() * (i + 1));
[arr[i], arr[j]] = [arr[j], arr[i]];
}
return arr;
}

// =====================================
// LÓGICA DEL TEST
// =====================================
function startMainTest(){
currentIndex = 0; correctAnswers = 0; wrongAnswers = 0; mistakes = [];
// Seleccionar aleatoriamente 30 preguntas del pool de 60
currentQuestions = shuffle(questionPool).slice(0, QUESTIONS_PER_TEST);
reviewMode = false;

questionTotal.textContent = currentQuestions.length;
showQuizScreen();
renderQuestion();
}

function startReviewMode(){
currentIndex = 0; correctAnswers = 0; wrongAnswers = 0;
currentQuestions = shuffle(mistakes);
reviewMode = true;

questionTotal.textContent = currentQuestions.length;
showQuizScreen();
renderQuestion();
}

function renderQuestion(){
nextBtn.classList.add("hidden");
updateStats();

const item = currentQuestions[currentIndex];
questionText.textContent = item.q;
questionNumber.textContent = currentIndex + 1;
progressBar.style.width = `${((currentIndex) / currentQuestions.length) * 100}%`;

const shuffledOptions = shuffle(item.options);
optionsContainer.innerHTML = "";

shuffledOptions.forEach(option => {
const btn = document.createElement("button");
btn.className = "option-btn";
btn.innerHTML = `<span>${option}</span>`;

btn.addEventListener("click", () => {
const buttons = document.querySelectorAll(".option-btn");
buttons.forEach(b => {
b.disabled = true;
if(b.textContent === item.correct){
b.classList.add("correct-answer");
}
});

if(option === item.correct){
correctAnswers++;
} else {
wrongAnswers++;
btn.classList.add("wrong-answer");

const hintSpan = document.createElement("span");
hintSpan.className = "hint";
hintSpan.innerHTML = `💡 <strong>Pista:</strong> ${item.hint}`;

// Buscar el botón correcto para añadirle la pista debajo
buttons.forEach(b => {
if(b.textContent === item.correct){
b.appendChild(hintSpan);
}
});

if(!mistakes.includes(item)){
mistakes.push(item);
}
}
updateStats();
nextBtn.classList.remove("hidden");
});
optionsContainer.appendChild(btn);
});
}

function nextQuestion(){
currentIndex++;
if(currentIndex < currentQuestions.length){
renderQuestion();
} else {
showResults();
}
}

function showResults(){
quizScreen.classList.add("hidden");
resultScreen.classList.remove("hidden");

const total = currentQuestions.length;
const percentage = Math.round((correctAnswers / total) * 100);

finalScore.textContent = `${correctAnswers} / ${total}`;
finalPercentage.textContent = `${percentage}%`;

if(percentage >= 85){
resultTitle.textContent = "🏆 ¡Impresionante, Dani!";
resultTitle.className = "result-title success";
} else {
resultTitle.textContent = "❌ ¡No te rindas, repasa tus fallos!";
resultTitle.className = "result-title fail";
}

if(mistakes.length > 0 && !reviewMode){
mistakesSection.classList.remove("hidden");
mistakesList.innerHTML = "";
mistakes.forEach(questionObj => {
const li = document.createElement("li");
li.innerHTML = `<strong>${questionObj.q}</strong><br>Respuesta correcta: <span class="correct">${questionObj.correct}</span>`;
mistakesList.appendChild(li);
});
} else {
mistakesSection.classList.add("hidden");
}
}

function updateStats(){
correctCount.textContent = correctAnswers;
wrongCount.textContent = wrongAnswers;
modeBadge.textContent = reviewMode ? "MODO REPASO DE ERRORES" : "TEST PRINCIPAL (30 PREGUNTAS)";
}

function showQuizScreen(){
resultScreen.classList.add("hidden");
quizScreen.classList.remove("hidden");
}

nextBtn.addEventListener("click", nextQuestion);
restartBtn.addEventListener("click", startMainTest);
reviewBtn.addEventListener("click", startReviewMode);

// INICIAR AL CARGAR
startMainTest();
</script>
