<guion>
// =====================================
// BASE DE DATOS: 60 PREGUNTAS (Teoría y Práctica)
// =====================================
const questionPool = [
// --- TEORÍA EN ESPAÑOL (15 preguntas) ---
{ q: "TEORÍA: ¿Qué tiempo verbal usamos para hacer PROMESAS ('I promise...')?", options: ["Will", "Be going to", "Present Continuous", "Present Simple"], correct: "Will", hint: "Las promesas siempre se hacen con Will." },
{ q: "TEORÍA: ¿Qué usamos para DECISIONES RÁPIDAS tomadas en el mismo momento de hablar?", options: ["Will", "Be going to", "Present Continuous", "Past Simple"], correct: "Will", hint: "Ejemplo: Suena el teléfono y decides contestar -> 'I will answer it'." },
{ q: "TEORÍA: ¿Qué tiempo verbal usamos para PLANES FIJOS o citas cerradas (con fecha, hora o lugar en tu agenda)?", options: ["Present Continuous", "Will", "Be going to", "Present Simple"], correct: "Present Continuous", hint: "Planes seguros al 100% como citas del médico o viajes con billete comprado." },
{ q: "TEORÍA: ¿Qué tiempo verbal usamos para INTENCIONES (cosas que tienes pensado hacer pero sin fecha fija)?", options: ["Be going to", "Will", "Present Continuous", "Present Simple"], correct: "Be going to", hint: "Ejemplo: 'Voy a estudiar más este año' -> I am going to study." },
{ q: "TEORÍA: ¿Qué usamos para PREDICCIONES que nos imaginamos sobre el futuro (normalmente con 'I think' o 'maybe')?", options: ["Will", "Be going to", "Present Continuous", "Past Continuous"], correct: "Will", hint: "Predicciones sin pruebas, basadas en tu opinión." },
{ q: "TEORÍA: ¿Qué usamos para PREDICCIONES BASADAS EN EVIDENCIAS visuales (ej. ves nubes muy negras y sabes que lloverá)?", options: ["Be going to", "Will", "Present Continuous", "Present Simple"], correct: "Be going to", hint: "Si tienes la prueba delante de tus ojos, usa 'be going to'." },
